# ---- copy to .env for local dev; set the same keys in Render for production ----
APP_ENV=development                # production on Render (turns on strict checks)
FRONTEND_ORIGIN=http://localhost:5173
EXTRA_CORS_ORIGINS=                # comma-separated, e.g. https://proofbridge.vercel.app
API_BASE_URL=http://localhost:8000
JWT_SIGNING_SECRET=                # python -c "import secrets;print(secrets.token_urlsafe(48))"
DEMO_ADMIN_SECRET=                 # same command; sent as X-Demo-Secret to /api/v1/demo/*

# Database: local SQLite by default. Supabase -> Connect -> Session pooler, then prefix postgresql+psycopg://
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<URL-ENCODED-PASSWORD>@<POOLER_HOST>:5432/postgres?sslmode=require
AUTO_CREATE_TABLES=true            # dev only; production uses `alembic upgrade head`

# Storage: local (no account needed) or r2
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=proof-bridge-evidence
R2_ENDPOINT=                       # https://<ACCOUNT_ID>.r2.cloudflarestorage.com
MAX_UPLOAD_BYTES=104857600

# Razorpay TEST mode only (the app refuses non rzp_test_ keys)
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=           # set the same value in Razorpay Dashboard -> Webhooks

# Disputes: the live mock (same routes as Razorpay). Uses the Razorpay test key/secret for Basic auth.
DISPUTES_PROVIDER=mock
MOCK_DISPUTES_BASE_URL=https://razorpay-mock-disputes.vercel.app
MOCK_DISPUTES_WEBHOOK_SECRET=      # same value as WEBHOOK_SECRET on the mock's Vercel project

# AI: fake (deterministic demo extractor) or gemini
AI_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash      # use the current Flash model shown in Google AI Studio
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite   # optional: used if the main model errors

# ---- merchant shown in the app ----
MERCHANT_NAME=Harshil Sharma

# ---- dispute nudges (in_app always works; email/whatsapp need the keys below) ----
NOTIFY_CHANNELS=in_app,push,email,whatsapp
REMINDER_HOURS=24,6                       # reminders before the deadline; run POST /api/v1/notifications/sweep from a cron
# Email via Resend (free). With onboarding@resend.dev, mail only reaches the Resend account owner's address.
RESEND_API_KEY=
MERCHANT_EMAIL=
NOTIFY_EMAIL_FROM=Razorpay Disputes <onboarding@resend.dev>
# WhatsApp Cloud API (Meta test number: free, up to 5 registered recipients)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MERCHANT_WHATSAPP=                        # e.g. 919812345678
WHATSAPP_TEMPLATE=                        # approved template with 4 body params; empty = text (needs a message from you in the last 24 h)
# Web Push to the installed app (phone notifications). Generate once: python scripts/vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
